# Copy to .env and fill in after deploying the contract (see scripts/deploy.sh).
# If VITE_CONTRACT_ID is left empty, the app runs against a local ledger
# simulation that enforces the same rules as the deployed contract, so the
# product is fully demoable before a live deployment exists.

VITE_CONTRACT_ID=
VITE_SOROBAN_RPC=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
